# Python AI Attendance Microservice (ArcFace + MiniFASNet)
AI_SERVICE_URL=http://127.0.0.1:8000

# Next.js Public Site Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma connection pool settings (respect your managed database connection limit)
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=20

# Server-side signed authentication session cookie key (use a unique random secret in production)
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Staff login secrets (server-only — never use NEXT_PUBLIC_ for these)
# ADMIN_LOGIN_PASSWORD=
# WARDEN_LOGIN_PASSWORD=
# GETPASS_LOGIN_PASSWORD=
# DEVELOPER_LOGIN_PASSWORD=

# Optional: protect cron + MSG91 voice webhook (recommended in production)
# CRON_SECRET=
# MSG91_WEBHOOK_SECRET=
